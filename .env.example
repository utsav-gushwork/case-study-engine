# Google OAuth — console.cloud.google.com → APIs & Services → Credentials →
# Create OAuth client ID (Web application). Authorized redirect URI:
#   https://<your-deployed-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=          # generate with: openssl rand -base64 32

# Unsplash — unsplash.com/developers, free tier, 50 req/hour. Hero photo
# search falls back to the icon treatment when this is unset.
UNSPLASH_ACCESS_KEY=

# Vercel KV — connect a store via the dashboard (Storage → Create Database →
# KV) and it injects these automatically; only needed once lib/db.ts's
# USE_KV flag is switched on. Not required for local dev with the in-memory
# store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
