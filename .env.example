# Google OAuth — console.cloud.google.com → APIs & Services → Credentials →
# Create OAuth client ID (Web application). Authorized redirect URI:
#   https://<your-deployed-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=          # generate with: openssl rand -base64 32

# Unsplash — unsplash.com/developers, free tier, 50 req/hour. Hero photo
# search falls back to the icon treatment when this is unset.
UNSPLASH_ACCESS_KEY=

# Upstash Redis — Vercel retired its own native "KV" product; connect an
# Upstash store via the dashboard (Storage → Browse Storage → Marketplace
# Database Providers → Upstash) and it injects the URL/token automatically
# (naming varies by integration version — lib/db.ts checks both). Only
# needed once USE_KV is switched on; not required for local dev with the
# in-memory store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
